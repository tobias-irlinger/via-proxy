# Copy to .env and fill in.

# Proxy domain; DNS: *.PROXY_DOMAIN -> this server,
# certificate: *.PROXY_DOMAIN (one wildcard is enough)
PROXY_DOMAIN=proxy.bib.example.org

# Shibboleth IdP with OIDC OP plugin; client registered with redirect URI
# https://login.<PROXY_DOMAIN>/oauth2/callback
OIDC_ISSUER_URL=https://idp.example.org
OIDC_CLIENT_ID=via-proxy
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPE=openid profile email

# values of eduperson_scoped_affiliation that may use the proxy
ALLOWED_AFFILIATIONS=member@example.org,student@example.org,staff@example.org

# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
# key for pseudonymising user ids in the access log: openssl rand -hex 32
VIA_LOG_KEY=

# optional
# directory with providers.json, changes are picked up every N seconds
#VIA_CONFIG_DIR=./config
#VIA_RELOAD_INTERVAL=5
# directory with fullchain.pem and privkey.pem (real files, no symlinks)
#VIA_CERT_DIR=/srv/via-proxy-certs

# ACME certificate (scripts/setup_acme.sh), same CA as the other HM projects
ACME_SERVER=https://acme.hm.edu/acme/acme/directory
# EAB credentials (from the PKI team)
ACME_EAB_KID=CHANGE-ME
ACME_EAB_HMAC_KEY=CHANGE-ME
# dns-rfc2136: wildcard via DNS challenge (needs a TSIG key for the zone)
# webroot:     only if the CA issues the wildcard without a DNS challenge
ACME_CHALLENGE=dns-rfc2136
ACME_RFC2136_SERVER=
ACME_RFC2136_NAME=
ACME_RFC2136_SECRET=
#ACME_RFC2136_PORT=53
#ACME_RFC2136_ALGORITHM=HMAC-SHA512
#ACME_EMAIL=noreply@notused.local
